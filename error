# 1. Make sure venv module is available
sudo apt install python3-full python3-venv

# 2. Create a virtual environment (name it whatever you like, e.g. "neuprint-env")
python3 -m venv ~/neuprint-env

# 3. Activate it
source ~/neuprint-env/bin/activate

# 4. Now install inside the venv — no more externally-managed error
pip install neuprint-python jupyter pandas

# 5. Launch jupyter from inside the venv
jupyter notebook
